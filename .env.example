# ==============================================================================
# Gulit Environment Variables Example
# Copy to .env.local for local development. Never commit real secrets to git.
# ==============================================================================

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=guilit
POSTGRES_PASSWORD=guilit
POSTGRES_DB=guilit
POSTGRES_PORT=5432
DATABASE_URL=postgresql://guilit:guilit@localhost:5432/guilit

# Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Telegram MTProto Ingestion (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+251911000000
TELEGRAM_SESSION_DIR=./sessions
TELEGRAM_SESSION_NAME=guilit_ingest

# Telegram Login Widget (web auth) & sessions
# Bot token from @BotFather; the bot's domain must be set via /setdomain to
# match NEXT_PUBLIC_APP_URL for the widget to work.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
# Signs session cookies (HS256 JWT) — keep stable across restarts/deploys,
# a rotating value logs everyone out. Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string

# Cloudflare R2 / S3 Object Storage (set STORAGE_BACKEND=local for local development)
STORAGE_BACKEND=local
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=guilit-media
R2_ENDPOINT_URL=
R2_PUBLIC_URL=https://media.guilit.et
LOCAL_STORAGE_DIR=./data/media

# Ingestion Pipeline Tuning
ALBUM_DEBOUNCE_SECONDS=3.0
ALLOWLIST_REFRESH_SECONDS=60
LOG_LEVEL=INFO
LOG_FORMAT=pretty

# Production Deployment (Caddy Reverse Proxy & TLS)
DOMAIN=guilit.et
ACME_EMAIL=admin@guilit.et
