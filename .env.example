# ==============================================================================
# Gulit Environment Variables Example
# Copy to .env.local for local development. Never commit real secrets to git.
# ==============================================================================

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=guilit
POSTGRES_PASSWORD=guilit
POSTGRES_DB=guilit
POSTGRES_PORT=5432
DATABASE_URL=postgresql://guilit:guilit@localhost:5432/guilit

# Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Telegram MTProto Ingestion (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+251911000000
TELEGRAM_SESSION_DIR=./sessions
TELEGRAM_SESSION_NAME=guilit_ingest

# Telegram Login Widget (web auth) & sessions
# Bot token from @BotFather; the bot's domain must be set via /setdomain to
# match NEXT_PUBLIC_APP_URL for the widget to work.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
# Signs session cookies (HS256 JWT) — keep stable across restarts/deploys,
# a rotating value logs everyone out. Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string
# Admin auto-promotion — set either one, the match is promoted on next request.
# ADMIN_TELEGRAM_USERNAME is matched against users.username (case-insensitive,
# leading "@" optional) and is the one that works for a plain Telegram login,
# since the Login Widget sends no phone number. ADMIN_PHONE is matched against
# users.phone, which only the OTP claim flow writes. Additional admins must be
# promoted in the DB.
ADMIN_TELEGRAM_USERNAME=your_telegram_handle
ADMIN_PHONE=+251911000000

# Cloudflare R2 / S3 Object Storage (set STORAGE_BACKEND=local for local development)
STORAGE_BACKEND=local
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=guilit-media
R2_ENDPOINT_URL=
R2_PUBLIC_URL=https://media.guilit.et
LOCAL_STORAGE_DIR=./data/media

# Gemini — vision autofill for native posts (lib/vision.ts) and text extraction
# in the ingest pipeline. Leave blank, or set to "mock", to run without any API
# call: autofill then returns fixed placeholder fields instead of failing.
# Vision is low-volume (native posts only), which is what makes Flash affordable.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Hard ceiling on the vision call. Past this the posting flow falls through to
# a plain manual form — do not raise this to paper over a slow model.
VISION_TIMEOUT_MS=5000

# Gemini — natural-language search parsing (lib/search-gemini.ts). Flash-Lite,
# one tiny call per query. Most searches never reach it: lib/search-rules.ts
# resolves prices, areas, conditions and categories deterministically, and the
# model is only consulted on what is left over. With GEMINI_API_KEY blank the
# rules are the whole parser, which is why mock mode and production behave the
# same for the queries a demo actually types.
GEMINI_PARSE_MODEL=gemini-2.0-flash-lite
# Budgeted against a 1.5s end-to-end target over Ethiopian mobile data, which
# leaves roughly 300ms of round trip on each side. Do not raise it — the rules
# have already answered by the time this is called.
SEARCH_PARSE_TIMEOUT_MS=900

# Price fairness (lib/price-stats.ts). How stale the materialised median/IQR
# buckets may get before a read rebuilds them. The scheduler in
# instrumentation.ts also rebuilds on server start and on this interval.
PRICE_STATS_TTL_SECONDS=900

# Native post uploads — server-side ceiling per photo. The browser resizes to
# ~400KB before uploading (lib/image-resize.ts); this is headroom above that.
MAX_UPLOAD_BYTES=600000

# Ingestion Pipeline Tuning
ALBUM_DEBOUNCE_SECONDS=3.0
ALLOWLIST_REFRESH_SECONDS=60
LOG_LEVEL=INFO
LOG_FORMAT=pretty

# Production Deployment (Caddy Reverse Proxy & TLS)
DOMAIN=guilit.et
ACME_EMAIL=admin@guilit.et
